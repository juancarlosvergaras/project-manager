# ---- Servidor ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
BASE_URL=https://diagnosticoiso.proyectoia.org
DB_PATH=/var/lib/diagnostico-iso/diagnostico.sqlite
# Obligatorio en producción: cadena aleatoria larga (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=cambie-este-valor
SESSION_DAYS=14

# ---- Autenticación ----
# gestor | local | mixto
AUTH_MODE=mixto
# Usuario administrador inicial (solo se crea si la tabla de usuarios está vacía)
ADMIN_EMAIL=admin@proyectoia.org
ADMIN_PASSWORD=cambie-esta-clave
ADMIN_NOMBRE=Administrador

# ---- Integración con el sistema de usuarios de gestor.proyectoia.org ----
GESTOR_NOMBRE=Gestor ProyectoIA
GESTOR_URL=https://gestor.proyectoia.org
# URL de inicio de sesión del gestor. Recibe la URL de retorno en el parámetro GESTOR_REDIRECT_PARAM.
GESTOR_LOGIN_URL=https://gestor.proyectoia.org/login
GESTOR_REDIRECT_PARAM=redirect_uri
GESTOR_CLIENT_ID=diagnosticoiso
# Nombre del parámetro con el que el gestor devuelve el token en /auth/gestor/callback
GESTOR_TOKEN_PARAM=token
# Opción A (recomendada): el gestor expone un endpoint que valida el token y devuelve el perfil
GESTOR_USERINFO_URL=https://gestor.proyectoia.org/api/me
GESTOR_API_KEY=
# Opción B: verificación local de JWT firmado por el gestor (HS256 con secreto compartido o RS256 con clave pública PEM)
GESTOR_JWT_SECRET=
GESTOR_JWT_PUBLIC_KEY=
GESTOR_JWT_ISSUER=
GESTOR_JWT_AUDIENCE=
# Opción C: cookie de sesión compartida en el dominio .proyectoia.org (requiere GESTOR_USERINFO_URL)
GESTOR_SESSION_COOKIE=
# Roles del gestor que se traducen a administrador y consultor en esta herramienta
GESTOR_ADMIN_ROLES=admin,administrador,superadmin
GESTOR_CONSULTOR_ROLES=consultor,auditor,gestor,docente

# ---- Enlace de retorno ----
APP_PROYECTOIA_URL=https://app.proyectoia.org
