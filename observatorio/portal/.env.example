# Copie este archivo como .env y ajuste los valores. Ninguna clave se guarda en el repositorio.

# Puerto y direccion publica del portal
PUERTO=8100
URL_PUBLICA=https://observatorio.proyectoia.org

# Clave con la que el portal firma sus cookies de sesion (64 caracteres hexadecimales)
CLAVE_SESION=cambie-esta-clave-por-una-aleatoria-de-64-caracteres

# Ruta del archivo de base de datos del portal (SQLite)
RUTA_BD=./datos/portal.sqlite

# Duracion de la sesion del portal en horas
HORAS_SESION=10

# Aplicaciones conectadas. Una linea por aplicacion, con el prefijo APP_<CLAVE>_
# El conector es el archivo observatorio-conector.php desplegado dentro de cada aplicacion.
APP_SOLUCION_NOMBRE=Solución Automatizada
APP_SOLUCION_URL=https://solucion.proyectoia.org
APP_SOLUCION_CONECTOR=https://solucion.proyectoia.org/observatorio-conector.php
APP_SOLUCION_SECRETO=secreto-compartido-solucion-64-caracteres
APP_SOLUCION_ORDEN=1

APP_CATALOGO_NOMBRE=Catálogo de IA
APP_CATALOGO_URL=https://catalogoia.proyectoia.org
APP_CATALOGO_CONECTOR=https://catalogoia.proyectoia.org/observatorio-conector.php
APP_CATALOGO_SECRETO=secreto-compartido-catalogo-64-caracteres
APP_CATALOGO_ORDEN=2

# Intervalo de recoleccion de datos en minutos (0 desactiva la recoleccion automatica)
MINUTOS_RECOLECCION=60

# Correos con rol de administrador del portal, separados por coma
ADMINISTRADORES=jvergaras@unicartagena.edu.co
